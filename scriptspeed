-- Slider táctil: arrastra la barra o escribe el valor
local function addSlider(text, key)
    local mn, mx = LIMITS[key][1], LIMITS[key][2]
    local row = card(scrollMove, 70)

    makeLabel(row, text, UDim2.new(1, -90, 0, 24), UDim2.new(0, 12, 0, 6), 14).Font = Enum.Font.GothamBold
    local box = makeBox(row, UDim2.fromOffset(64, 28), UDim2.new(1, -76, 0, 6))

    -- Zona táctil alta para que sea fácil de usar con el dedo
    local hit = Instance.new("TextButton")
    hit.Size = UDim2.new(1, -24, 0, 30)
    hit.Position = UDim2.new(0, 12, 0, 34)
    hit.BackgroundTransparency = 1
    hit.Text = ""
    hit.AutoButtonColor = false
    hit.Parent = row

    local track_ = Instance.new("Frame")
    track_.Size = UDim2.new(1, 0, 0, 8)
    track_.Position = UDim2.new(0, 0, 0.5, -4)
    track_.BackgroundColor3 = C.Btn
    track_.BorderSizePixel = 0
    track_.Parent = hit
    corner(track_, 4)

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = C.Accent
    fill.BorderSizePixel = 0
    fill.Parent = track_
    corner(fill, 4)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(24, 24)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    knob.ZIndex = 2
    knob.Parent = track_
    corner(knob, 12)

    local function show()
        local a = (S[key] - mn) / (mx - mn)
        fill.Size = UDim2.new(a, 0, 1, 0)
        knob.Position = UDim2.new(a, 0, 0.5, 0)
        box.Text = tostring(S[key])
    end

    local function setValue(v)
        S[key] = clamp(math.floor(v + 0.5), mn, mx)
        show()
        if enabled then applyAll() end
        saveSoon()
    end

    local dragging = false
    local function fromInput(input)
        local w = track_.AbsoluteSize.X
        if w <= 0 then return end
        local a = clamp((input.Position.X - track_.AbsolutePosition.X) / w, 0, 1)
        setValue(mn + a * (mx - mn))
    end

    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            sliderDragging = true
            scrollMove.ScrollingEnabled = false -- evita que la lista se mueva mientras arrastras
            fromInput(input)
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    sliderDragging = false
                    scrollMove.ScrollingEnabled = true
                end
            end)
        end
    end)
    track(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            fromInput(input)
        end
    end))

    box.FocusLost:Connect(function() setValue(tonumber(box.Text) or S[key]) end)
    table.insert(refreshers, show)
    show()
    return setValue
end

local function addToggle(parent, text, key, hint)
    local b = makeButton(parent, "", UDim2.new(1, 0, 0, 44), nil, C.Btn)
    b.LayoutOrder = nextOrder()
    local function r()
        b.Text = text .. ":  " .. (S[key] and "SÍ" or "NO")
        b.BackgroundColor3 = S[key] and C.Green or C.Btn
    end
    b.Activated:Connect(function()
        S[key] = not S[key]
        r()
        saveSoon()
    end)
    table.insert(refreshers, r)
    r()
    return b
end

