local function getHum()
    local char = player.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

-- JumpHeight equivalente a un JumpPower (para personajes que usan altura)
local function powerToHeight(p)
    return p * p / (2 * Workspace.Gravity)
end

local function close(a, b) return math.abs(a - b) < 0.01 end

local function applyAll()
    local hum = getHum()
    if enabled then
        Workspace.Gravity = S.Gravity
        if hum then
            hum.WalkSpeed = S.Speed
            if hum.UseJumpPower then
                hum.JumpPower = S.Jump
            else
                hum.JumpHeight = powerToHeight(S.Jump)
            end
        end
    else
        Workspace.Gravity = orig.Gravity
        if hum then
            hum.WalkSpeed = orig.Speed
            if hum.UseJumpPower then
                hum.JumpPower = orig.JumpPower
            else
                hum.JumpHeight = orig.JumpHeight
            end
        end
    end
end

local function refreshToggle()
    floatBtn.BackgroundColor3 = enabled and C.Green or C.Red
    for _, f in ipairs(refreshers) do f() end
end

local function setEnabled(v)
    if not running then return end
    enabled = v
    applyAll()
    refreshToggle()
    toast(enabled and "⚡ Activado" or "Desactivado (valores originales)")
end

-- Engancha un humanoide: guarda sus valores originales y evita que el juego los resetee
local function hookHumanoid(hum)
    -- Al reaparecer, el humanoide trae sus valores originales
    orig.Speed = hum.WalkSpeed
    orig.JumpPower = hum.JumpPower
    orig.JumpHeight = hum.JumpHeight

    local function guard(prop, want)
        track(hum:GetPropertyChangedSignal(prop):Connect(function()
            if running and enabled and S.Enforce then
                local target = want()
                if target and not close(hum[prop], target) then hum[prop] = target end
            end
        end))
    end
    guard("WalkSpeed", function() return S.Speed end)
    guard("JumpPower", function() return hum.UseJumpPower and S.Jump or nil end)
    guard("JumpHeight", function() return (not hum.UseJumpPower) and powerToHeight(S.Jump) or nil end)

    if enabled then applyAll() end
end

local function onCharacter(char)
    local hum = char:WaitForChild("Humanoid", 10)
    if hum and running then hookHumanoid(hum) end
end

track(player.CharacterAdded:Connect(function(char) task.spawn(onCharacter, char) end))
if player.Character then task.spawn(onCharacter, player.Character) end

