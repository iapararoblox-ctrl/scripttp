if type(S) ~= "table" then S = {} end
for k, v in pairs(newPlace()) do
    if type(S[k]) ~= type(v) then S[k] = v end
end
store.Places[placeKey] = S

local function save()
    pcall(function() writefile(FILE, HttpService:JSONEncode(store)) end)
end

-- Guardado diferido: evita escribir el archivo en cada movimiento del slider
local saveQueued = false
local function saveSoon()
    if saveQueued then return end
    saveQueued = true
    task.delay(1, function()
        saveQueued = false
        save()
    end)
end

